{
  "name": "ivo",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.mjs",
  "type": "module",
  "description": "Linked documents with precise page composition, stored in portable vaults.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/unit/*.test.js",
    "test:graph": "electron tests/runtime/graph/runner.mjs",
    "build": "node scripts/build.mjs",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && node scripts/package-desktop.mjs",
    "ios:prepare": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "test:native": "node --test --test-timeout=180000 tests/native/*.test.js",
    "test:editor": "electron tests/runtime/editor/runner.mjs",
    "test:scene": "electron tests/runtime/scene/runner.mjs",
    "test:viewport": "electron tests/runtime/viewport/runner.mjs",
    "pretest:scene": "node scripts/reference-art.mjs",
    "pretest:viewport": "node scripts/reference-art.mjs",
    "pretest:graph": "node scripts/reference-art.mjs",
    "test:render": "electron tests/runtime/render/runner.mjs",
    "test:interaction": "electron tests/runtime/interaction/runner.mjs",
    "pretest:interaction": "node scripts/reference-art.mjs",
    "test:text": "electron tests/runtime/text/runner.mjs",
    "pretest:text": "node scripts/reference-art.mjs",
    "test:browser-storage": "electron tests/runtime/browser-storage/runner.mjs",
    "test:pdf": "npm run build && electron tests/runtime/pdf/runner.mjs",
    "test:templates": "electron tests/runtime/template/runner.mjs",
    "pretest:templates": "node scripts/reference-art.mjs",
    "test:workspace": "electron tests/runtime/workspace/runner.mjs",
    "pretest:workspace": "node scripts/reference-art.mjs",
    "test:daily-use": "electron tests/runtime/daily-use/runner.mjs",
    "pretest:daily-use": "node scripts/reference-art.mjs",
    "test:vaults": "npm run build && electron tests/runtime/vault/runner.mjs",
    "test:duplicate": "electron tests/runtime/duplicate/runner.mjs",
    "pretest:duplicate": "node scripts/reference-art.mjs",
    "test:previews": "electron tests/runtime/link-preview/runner.mjs",
    "pretest:previews": "node scripts/reference-art.mjs",
    "test:navigation": "electron tests/runtime/workspace-navigation/runner.mjs",
    "pretest:navigation": "node scripts/reference-art.mjs",
    "test:tabs": "electron tests/runtime/tab-interaction/runner.mjs",
    "pretest:tabs": "node scripts/reference-art.mjs",
    "test:shell": "electron tests/runtime/shell/runner.mjs",
    "pretest:shell": "node scripts/reference-art.mjs",
    "test:windows": "npm run build && node tests/runtime/workspace-window/run.mjs",
    "test:window-refresh": "electron tests/runtime/window-refresh/runner.mjs",
    "pretest:window-refresh": "node scripts/reference-art.mjs",
    "test:text-flows": "electron tests/runtime/text-flow-layout/runner.mjs && electron tests/runtime/document-text/runner.mjs",
    "pretest:text-flows": "node scripts/reference-art.mjs",
    "format": "prettier --write src desktop scripts tests *.js *.json *.html docs README.md CONTRIBUTING.md",
    "format:check": "prettier --check src desktop scripts tests *.js *.json *.html docs README.md CONTRIBUTING.md",
    "lint": "eslint src desktop scripts tests eslint.config.js",
    "precheck:architecture": "node scripts/reference-art.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "node scripts/check.mjs",
    "test:runtime": "node scripts/check.mjs --runtime",
    "test:build": "npm run build && electron tests/runtime/build/runner.mjs",
    "test:workspace-features": "electron tests/runtime/workspace-features/runner.mjs",
    "pretest:workspace-features": "node scripts/reference-art.mjs",
    "test:workspace-views": "electron tests/runtime/workspace-views/runner.mjs",
    "pretest:workspace-views": "node scripts/reference-art.mjs",
    "test:startup": "npm run build && electron tests/runtime/startup/runner.mjs",
    "test:inline-metrics": "electron tests/runtime/inline-metrics/runner.mjs",
    "pretest:inline-metrics": "node scripts/reference-art.mjs",
    "test:publishing": "electron tests/runtime/publishing/runner.mjs",
    "pretest:publishing": "node scripts/reference-art.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "electron": "45.2.2",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "prettier": "3.10.1"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "pdf-lib": "1.17.1"
  }
}
